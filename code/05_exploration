within_group_cor <- function(data, group, vars = numeric_vars) {
  levs <- sort(unique(data[[group]]))
  res <- sapply(levs, function(l) {
    sub <- data[data[[group]] == l, ]
    sapply(vars, function(v) {
      ok <- !is.na(sub[[v]])
      if (sd(sub$won[ok]) == 0 || sd(sub[[v]][ok]) == 0) NA
      else cor(sub[[v]][ok], sub$won[ok], method = "spearman")
    })
  })
  colnames(res) <- levs
  round(res, 2)
}

within_group_cor(df, "ico.status")
within_group_cor(df[df$party %in% c(100, 200, 328), ], "party")
within_group_cor(df, "cand.gender")

