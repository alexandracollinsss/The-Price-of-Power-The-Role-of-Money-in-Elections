# signed log transform for skewed money variables (handles zeros/negatives)
slog <- function(x) sign(x) * log1p(abs(x))

# AUC of a single predictor = P(random winner scores higher than random loser)
# computed from ranks (Mann-Whitney), ties handled by average ranks
auc <- function(x, y) {
  r <- rank(x)
  n1 <- sum(y == 1); n0 <- sum(y == 0)
  (sum(r[y == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
}

## ---------- numeric predictors ----------
num_tbl <- do.call(rbind, lapply(numeric_vars, function(v) {
  x <- df[[v]]
  ok <- !is.na(x)
  xt <- if (v %in% money_vars) slog(x) else x
  data.frame(
    variable            = v,
    n_used              = sum(ok),
    pearson_raw         = cor(x[ok],  y[ok]),
    pearson_transformed = cor(xt[ok], y[ok]),
    spearman            = cor(x[ok],  y[ok], method = "spearman"),
    auc_single          = auc(x[ok], y[ok])
  )
}))
num_tbl <- num_tbl[order(-abs(num_tbl$spearman)), ]
cat("\n=== Numeric predictors vs. won (sorted by |Spearman|) ===\n")
print(num_tbl, digits = 3, row.names = FALSE)

## ---------- categorical predictors ----------
cramers_v <- function(a, b) {
  ct <- table(a, b)
  chi2 <- suppressWarnings(chisq.test(ct, correct = FALSE)$statistic)
  sqrt(as.numeric(chi2) / (sum(ct) * (min(dim(ct)) - 1)))
}

cat("\n=== Categorical predictors vs. won ===\n")
for (v in setdiff(cat_vars, "state")) {
  cat("\n", v, ":\n", sep = "")
  tab <- data.frame(
    n        = as.vector(table(df[[v]])),
    win_rate = round(as.vector(tapply(y, df[[v]], mean)), 3),
    row.names = names(table(df[[v]]))
  )
  print(tab)
}
cat_tbl <- data.frame(
  variable  = cat_vars,
  n_levels  = sapply(cat_vars, function(v) length(unique(df[[v]]))),
  cramers_v = sapply(cat_vars, function(v) cramers_v(df[[v]], y))
)
cat_tbl <- cat_tbl[order(-cat_tbl$cramers_v), ]
cat("\nCramer's V (0 = no association, 1 = perfect):\n")
print(cat_tbl, digits = 3, row.names = FALSE)
cat("\nNote: state has many levels, so V is inflated by small cells.\n")

