# n, win rate, and medians of key covariates for each level of a grouping variable
summarize_groups <- function(data, group) {
  vars <- c("num.givers", "total.receipts", "total.pac.contribs",
            "total.contribs.from.candidate", "district.pres.vs", "recipient.cfscore")
  g <- data[[group]]
  out <- data.frame(
    n        = as.vector(table(g)),
    win_rate = round(as.vector(tapply(data$won, g, mean)), 3),
    row.names = names(table(g))
  )
  for (v in vars)
    out[[v]] <- round(as.vector(tapply(data[[v]], g, median, na.rm = TRUE)), 2)
  out
}

summarize_groups(df, "ico.status")
summarize_groups(df[df$party %in% c(100, 200, 328), ], "party")   # drop tiny party 328
summarize_groups(df, "cand.gender")

